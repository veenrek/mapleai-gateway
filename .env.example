# --- required ---------------------------------------------------------------
# Address that receives USDC payments (Solana base58 or EVM 0x…, must match NETWORK)
PAY_TO=YourSolanaAddressHere

# Upstream OpenAI-compatible provider you are reselling
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-upstream-key
# Optional: same upstream, used if the primary credential is rejected or rate-limited.
# BACKUP_UPSTREAM_API_KEY=your-backup-key
# Image credentials are kept separate; image routes require confirmed upstream access.
# IMAGE_UPSTREAM_API_KEY=your-image-key
# Enable image endpoints only after confirming every upstream cost. Each entry is
# a SELLING price in USD per image for one exact size. Quote adds settlement gas.
# IMAGE_PRICES={"gpt-image-2":0.02,"gpt-image-2.5":0.04}
# Jev uses its own SystemOne credential and a selling price per 1M input tokens.
# Both values are required to enable POST /jev.
# JEV_UPSTREAM_API_KEY=your-jev-key
# JEV_INPUT_PRICE_PER_MILLION=0.06
# Live X/Twitter search (POST /v1/x/search), served through the admin combo router
# (COMBO_UPSTREAM_BASE_URL + X402_INTERNAL_LUNA_KEY; the combo named below must
# exist in the admin panel and the internal key must allow it).
# Price = base + per_result x max_results (+web surcharge when include_web).
# X_SEARCH_COMBO_MODEL=grok-4.6-search
# X_SEARCH_BASE_PRICE_USD=0.015
# X_SEARCH_PER_RESULT_USD=0.0015
# X_SEARCH_WEB_PRICE_USD=0.01
# Packaged X intelligence endpoints: POST /v1/x/digest, /v1/x/sentiment,
# /v1/x/factcheck. Same combo plumbing as /v1/x/search; per-endpoint price
# coefficients below. Usage log: X_INTEL_DATA_FILE (default ./xintel-data.jsonl).
# X_DIGEST_BASE_USD=0.02
# X_DIGEST_PER_HANDLE_USD=0.005
# X_DIGEST_MEDIA_USD=0.005
# X_SENTIMENT_BASE_USD=0.025
# X_SENTIMENT_PER_EXAMPLE_USD=0.0015
# X_SENTIMENT_PER_DAY_USD=0.005
# X_FACTCHECK_BASE_USD=0.03
# X_FACTCHECK_PER_SOURCE_USD=0.002
# Profile dossier and media radar (POST /v1/x/profile, /v1/x/media) and web
# search (POST /v1/web/search), same combo plumbing:
# X_PROFILE_BASE_USD=0.02
# X_PROFILE_PER_HANDLE_USD=0.015
# X_MEDIA_BASE_USD=0.02
# X_MEDIA_PER_RESULT_USD=0.002
# X_WEB_BASE_PRICE_USD=0.015
# X_WEB_PER_RESULT_USD=0.001
# NVIDIA_API_KEY=nvapi-your-key
# Audio (TTS + STT) is served through the admin combo router
# (COMBO_UPSTREAM_BASE_URL + X402_INTERNAL_LUNA_KEY); provider credentials and
# any geo-unblocking proxy live in the admin panel's provider connections.
#   POST /v1/audio/speech          models tts-1, tts-1-hd
#   POST /v1/audio/transcriptions  model whisper-1
# Upstream ids on the admin audio router ("provider/model"):
# AUDIO_TTS_UPSTREAM=gemini/gemini-3.8-flash-lite-tts
# AUDIO_TTS_HD_UPSTREAM=gemini/gemini-3.8-flash-tts
# AUDIO_TTS_ORPHEUS_EN_UPSTREAM=groq/canopylabs/orpheus-v1-english
# AUDIO_TTS_ORPHEUS_AR_UPSTREAM=groq/canopylabs/orpheus-arabic-saudi
# AUDIO_STT_UPSTREAM=gemini/gemini-3.5-transcribe
# AUDIO_STT_V3_UPSTREAM=groq/whisper-large-v3
# AUDIO_STT_TURBO_UPSTREAM=groq/whisper-large-v3-turbo
# AUDIO_TTS_PRICE_USD=0.015
# AUDIO_STT_PRICE_USD=0.006
# Enables NFT contract metadata across the supported Infura EVM mainnets.
# INFURA_PROJECT_ID=your-infura-project-id
# EMBEDDING_STATS_TOKEN=long-random-admin-token

# Internal loopback issuer for x402 prepaid token packs. Configure the same
# random token in /etc/mapleai-admin.env and this gateway's .env.
# PREPAID_ISSUER_URL=http://127.0.0.1:4031/api/internal/prepaid-codes
# PREPAID_ISSUER_TOKEN=long-random-shared-token

# --- optional ---------------------------------------------------------------
PORT=4021
PAYMENT_EVENTS_FILE=./payment-events.jsonl

# solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 = Solana devnet (testnet, public facilitator)
# solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp  = Solana mainnet-beta (needs a Solana mainnet facilitator, e.g. PayAI)
# eip155:84532 = Base Sepolia, eip155:8453 = Base mainnet (supported by PayAI)
# eip155:5042 = Arc mainnet (USDC: 0x3600000000000000000000000000000000000000)
# eip155:4663 = Robinhood Chain mainnet (requires a verified USDC address and facilitator)
NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# Required only for Robinhood Chain after verifying the token contract.
# PAYMENT_ASSET_ADDRESS=0xYourVerifiedRobinhoodUsdcAddress

#FACILITATOR_URL=https://x402.org/facilitator
# Set FACILITATOR_MODE=cdp with CDP credentials to route this instance's
# verify/settle operations through Coinbase CDP. Supported here: Base,
# Polygon and Solana. Arc is not currently supported by CDP.
# FACILITATOR_MODE=cdp
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Optional per-model upstream override: requests for the listed upstream model
# ids are proxied to the internal combo router instead of the direct upstream.
# (Claude models are always combo-served via POST /v1/messages; listing them here
# also routes their OpenAI-format chat calls through the combo router.)
# COMBO_UPSTREAM_MODELS=gpt-6-luna,claude-sonnet-5,claude-opus-4-8,claude-opus-5
# COMBO_UPSTREAM_BASE_URL=http://127.0.0.1:4031/api/v1
# X402_INTERNAL_LUNA_KEY=<internal prepaid key for the combo>

# Optional free gpt-oss-20b tier (POST /v1/free/chat/completions), combo-routed.
# X402_INTERNAL_OSS_KEY=<internal prepaid key for the gpt-oss-20b combo>
# FREE_OSS_PER_10MIN=10
# FREE_OSS_PER_DAY=100
# FREE_OSS_MAX_TOKENS=2048

# Per-model pricing (JSON). Two shapes per model:
#   {"model":"$0.01"}                        flat price per request
#   {"model":{"input":0.15,"output":0.6}}    $ per 1M input / output tokens
# Token-priced models are quoted as: counted input tokens + max_tokens (or
# OUTPUT_TOKEN_ESTIMATE) output, times the rates, times PRICE_MARKUP, plus
# FACILITATOR_FEE_USD, floored at MIN_CHARGE_USD. Models not listed here are
# rejected with 400.
MODEL_PRICES={"openai/gpt-5.6-sol":{"input":2.8,"output":14},"openai/gpt-5.6-terra":{"input":1.4,"output":8.4},"openai/gpt-6-luna":{"input":0.07,"output":0.35},"openai/gpt-6-sol":{"input":1.4,"output":7},"anthropic/claude-haiku-4-5":{"input":0.5,"output":2.5},"anthropic/claude-sonnet-4-5":{"input":1.5,"output":7.5},"anthropic/claude-sonnet-4-6":{"input":1.5,"output":7.5},"anthropic/claude-sonnet-5":{"input":1,"output":5},"anthropic/claude-sonnet-5-5":{"input":1.5,"output":7.5},"anthropic/claude-opus-4-6":{"input":2.5,"output":12.5},"anthropic/claude-opus-4-7":{"input":2.5,"output":12.5},"anthropic/claude-opus-4-8":{"input":2.5,"output":12.5},"anthropic/claude-opus-5":{"input":2.5,"output":12.5},"anthropic/claude-opus-5-5":{"input":2.5,"output":12.5}}
DEFAULT_PRICE=$0.01
MIN_CHARGE_USD=0.001

# Our catalog id -> the id the upstream provider expects.
# Format: {"our-model-id":"upstream-model-id"}. Clients may also send the bare
# upstream id; it resolves to the canonical catalog entry.
MODEL_MAPPING={"openai/gpt-5.6-sol":"gpt-5.6-sol","openai/gpt-5.6-terra":"gpt-5.6-terra","openai/gpt-6-luna":"gpt-6-luna","openai/gpt-6-sol":"gpt-6-sol","anthropic/claude-haiku-4-5":"claude-haiku-4-5","anthropic/claude-sonnet-4-5":"claude-sonnet-4-5","anthropic/claude-sonnet-4-6":"claude-sonnet-4-6","anthropic/claude-sonnet-5":"claude-sonnet-5","anthropic/claude-sonnet-5-5":"claude-sonnet-5-5","anthropic/claude-opus-4-6":"claude-opus-4-6","anthropic/claude-opus-4-7":"claude-opus-4-7","anthropic/claude-opus-4-8":"claude-opus-4-8","anthropic/claude-opus-5":"claude-opus-5","anthropic/claude-opus-5-5":"claude-opus-5-5"}

# Quoting knobs
OUTPUT_TOKEN_ESTIMATE=8192
OUTPUT_TOKEN_CAP=16384
PRICE_MARKUP=1.25
FACILITATOR_FEE_USD=0.001

# Branding + public documents (landing page, llms.txt, AI-AGENTS.md, openapi.json)
SERVICE_NAME=MapleAI
CONTACT_EMAIL=contact@example.com
# Pin canonical URLs. Leave empty to derive the origin from each request's Host.
PUBLIC_BASE_URL=

# x402scan ownership proofs (comma-separated signatures over each origin,
# generated with tools/sign-ownership-proof.mjs from the treasury keys)
# X402_OWNERSHIP_PROOFS=

# Sandboxed code_exec tool for POST /v1/agents/execute (Piston on a dedicated
# executor host, reached through a WireGuard tunnel — never expose Piston to
# the public internet). Off by default; the tool disappears from the allowed
# list and explicit requests for it fail with "disabled on this deployment".
# CODE_EXEC_PROVIDER=piston
# CODE_EXEC_URL=http://10.0.0.2:2000
# Per-call price added to the quote ceiling, and the per-task call cap:
# CODE_EXEC_PER_CALL_USD=0.002
# CODE_EXEC_MAX_PER_TASK=3
