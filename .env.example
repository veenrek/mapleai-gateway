# --- required ---------------------------------------------------------------
# Address that receives USDC payments (Solana base58 or EVM 0x…, must match NETWORK)
PAY_TO=YourSolanaAddressHere

# Upstream OpenAI-compatible provider you are reselling
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-upstream-key
# Optional: same upstream, used if the primary credential is rejected or rate-limited.
# BACKUP_UPSTREAM_API_KEY=your-backup-key
# Image credentials are kept separate; image routes require confirmed upstream access.
# IMAGE_UPSTREAM_API_KEY=your-image-key
# Enable image endpoints only after confirming every upstream cost. Each entry is
# a SELLING price in USD per image for one exact size. Quote adds settlement gas.
# IMAGE_PRICES={"gpt-image-2":0.02,"gpt-image-2.5":0.04}
# Jev uses its own SystemOne credential and a selling price per 1M input tokens.
# Both values are required to enable POST /jev.
# JEV_UPSTREAM_API_KEY=your-jev-key
# JEV_INPUT_PRICE_PER_MILLION=0.06
# NVIDIA_API_KEY=nvapi-your-key
# Enables NFT contract metadata across the supported Infura EVM mainnets.
# INFURA_PROJECT_ID=your-infura-project-id
# EMBEDDING_STATS_TOKEN=long-random-admin-token

# Internal loopback issuer for x402 prepaid token packs. Configure the same
# random token in /etc/mapleai-admin.env and this gateway's .env.
# PREPAID_ISSUER_URL=http://127.0.0.1:4031/api/internal/prepaid-codes
# PREPAID_ISSUER_TOKEN=long-random-shared-token

# --- optional ---------------------------------------------------------------
PORT=4021
PAYMENT_EVENTS_FILE=./payment-events.jsonl

# solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 = Solana devnet (testnet, public facilitator)
# solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp  = Solana mainnet-beta (needs a Solana mainnet facilitator, e.g. PayAI)
# eip155:84532 = Base Sepolia, eip155:8453 = Base mainnet (supported by PayAI)
# eip155:5042 = Arc mainnet (USDC: 0x3600000000000000000000000000000000000000)
# eip155:4663 = Robinhood Chain mainnet (requires a verified USDC address and facilitator)
NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# Required only for Robinhood Chain after verifying the token contract.
# PAYMENT_ASSET_ADDRESS=0xYourVerifiedRobinhoodUsdcAddress

#FACILITATOR_URL=https://x402.org/facilitator
# Set FACILITATOR_MODE=cdp with CDP credentials to route this instance's
# verify/settle operations through Coinbase CDP. Supported here: Base,
# Polygon and Solana. Arc is not currently supported by CDP.
# FACILITATOR_MODE=cdp
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Optional per-model upstream override: requests for the listed upstream model
# ids are proxied to the internal combo router instead of the direct upstream.
# COMBO_UPSTREAM_MODELS=gpt-6-luna
# COMBO_UPSTREAM_BASE_URL=http://127.0.0.1:4031/api/v1
# X402_INTERNAL_LUNA_KEY=<internal prepaid key for the combo>

# Optional free gpt-oss-20b tier (POST /v1/free/chat/completions), combo-routed.
# X402_INTERNAL_OSS_KEY=<internal prepaid key for the gpt-oss-20b combo>
# FREE_OSS_PER_10MIN=10
# FREE_OSS_PER_DAY=100
# FREE_OSS_MAX_TOKENS=2048

# Per-model pricing (JSON). Two shapes per model:
#   {"model":"$0.01"}                        flat price per request
#   {"model":{"input":0.15,"output":0.6}}    $ per 1M input / output tokens
# Token-priced models are quoted as: counted input tokens + max_tokens (or
# OUTPUT_TOKEN_ESTIMATE) output, times the rates, times PRICE_MARKUP, plus
# FACILITATOR_FEE_USD, floored at MIN_CHARGE_USD. Models not listed here are
# rejected with 400.
MODEL_PRICES={"openai/gpt-5.6-sol":{"input":2.8,"output":14},"openai/gpt-5.6-terra":{"input":1.4,"output":8.4},"openai/gpt-6-luna":{"input":0.07,"output":0.35},"openai/gpt-6-sol":{"input":1.4,"output":7}}
DEFAULT_PRICE=$0.01
MIN_CHARGE_USD=0.001

# Our catalog id -> the id the upstream provider expects.
# Format: {"our-model-id":"upstream-model-id"}. Clients may also send the bare
# upstream id; it resolves to the canonical catalog entry.
MODEL_MAPPING={"openai/gpt-5.6-sol":"gpt-5.6-sol","openai/gpt-5.6-terra":"gpt-5.6-terra","openai/gpt-6-luna":"gpt-6-luna","openai/gpt-6-sol":"gpt-6-sol"}

# Quoting knobs
OUTPUT_TOKEN_ESTIMATE=8192
OUTPUT_TOKEN_CAP=16384
PRICE_MARKUP=1.25
FACILITATOR_FEE_USD=0.001

# Branding + public documents (landing page, llms.txt, AI-AGENTS.md, openapi.json)
SERVICE_NAME=MapleAI
CONTACT_EMAIL=contact@example.com
# Pin canonical URLs. Leave empty to derive the origin from each request's Host.
PUBLIC_BASE_URL=

# x402scan ownership proofs (comma-separated signatures over each origin,
# generated with tools/sign-ownership-proof.mjs from the treasury keys)
# X402_OWNERSHIP_PROOFS=
