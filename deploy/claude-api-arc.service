[Unit]
Description=MapleAI x402 gateway (Arc mainnet)
After=network-online.target arc-facilitator.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/claude-api-arc
ExecStart=/opt/node22/bin/node --import tsx src/index.ts
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
