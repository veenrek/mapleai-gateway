[Unit]
Description=MapleAI x402 gateway (Polygon mainnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/claude-api-polygon
ExecStart=/opt/node22/bin/node --import tsx src/index.ts
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
