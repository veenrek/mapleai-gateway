[Unit]
Description=Arc x402 facilitator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/arc-facilitator
EnvironmentFile=/etc/arc-facilitator.env
ExecStart=/opt/node22/bin/node --import tsx src/facilitator.ts
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
