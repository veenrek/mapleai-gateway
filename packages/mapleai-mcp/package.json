{
  "name": "mapleai-mcp",
  "version": "0.2.0",
  "description": "Local MCP tools for MapleAI models with x402 USDC payments",
  "type": "module",
  "bin": {
    "mapleai-mcp": "dist/server.js",
    "mapleai-quickstart": "dist/quickstart.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node smoke-test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@scure/base": "^2.4.0",
    "@solana/kit": "^5.5.1",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/svm": "^2.27.0",
    "viem": "^2.48.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
