# Copy to .env for the paid scenario. Keys are read from the environment only —
# .env is gitignored, never commit real keys.

# Solana wallet (base58 private key), pays on sol.mapleai.shop
SVM_PRIVATE_KEY=

# EVM wallet (0x private key), pays on base.mapleai.shop
EVM_PRIVATE_KEY=

# Optional: pin the network for npm run scenario (default: base)
MCP_NETWORK=base

# Optional: issued prepaid key (oms_buy_...) if you already own one
MAPLEAI_PREPAID_KEY=
